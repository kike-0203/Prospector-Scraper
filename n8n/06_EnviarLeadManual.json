        "jsCode": "const normal = $('CODE_ContinuarEnvio').first().json;\nconst r = $input.first().json || {};\nconst data = r._data || {};\nconst candidate = data.id?._serialized || r.id?._serialized || (typeof r.id === 'string' ? r.id : '') || r.messageId || r.message?.id;\nconst textId = typeof candidate === 'string' ? candidate.trim() : '';\nif (!textId || r.error || Number(r.statusCode || 0) >= 400) throw new Error('WAHA no confirmo el texto; detener sin reintentar');\nlet material = {};\nif (normal.tipo_envio === 'texto_material' && normal.material_id) material = $('PB_LeerMaterial').first().json;\nconst requiere_video = normal.tipo_envio === 'texto_material' && material.tipo === 'video' && !!material.archivo;\nreturn [{ json: { ...normal, tipo: material.tipo || '', archivo: material.archivo || '', text_message_id: textId, requiere_video } }];"
