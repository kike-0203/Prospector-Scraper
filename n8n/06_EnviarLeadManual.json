        "jsCode": "const result = $input.first().json;\nif (result.numberExists !== true || typeof result.chatId !== 'string' || !result.chatId.includes('@')) {\n  throw new Error('WAHA no devolvio un chat confirmado; no se enviara el mensaje');\n}\nconst normal = $('CODE_NormalizarEnvio').first().json;\nconst merged = $('Merge_LeadCampana').first().json;\nreturn [{ json: { ...merged, ...normal, chatId: result.chatId } }];"
