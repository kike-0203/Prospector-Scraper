        "jsCode": "const normal = $('CODE_ValidarChatWAHA').first().json;\nconst r = $json || {};\nconst data = r._data || {};\nconst candidate = data.id?._serialized || (typeof r.id === 'string' ? r.id : '') || r.messageId || r.message?.id;\nconst messageId = typeof candidate === 'string' ? candidate.trim() : '';\nif (!messageId || r.error || Number(r.statusCode || 0) >= 400) {\n  throw new Error('WAHA no confirmo el envio con un ID; el lead sigue sin confirmacion');\n}\nreturn [{ json: { ...normal, enviado_por_waha: true, waha_message_id: messageId,\n  ack: r.ack ?? data.ack ?? '', fromMe: r.fromMe ?? data.id?.fromMe ?? '',\n  remote: data.id?.remote || r.to || normal.chatId } }];"
