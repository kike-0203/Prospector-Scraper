    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\nconst request = $('CODE_NormalizarEnvio').first().json;\nconst waha = $('CODE_RevisarRespuestaWAHA').first().json;\nconst followup = $('PB_CrearSeguimiento').first().json;\nif (lead.id !== request.lead_id || lead.estado !== 'enviado_manual' || lead.estado_mensaje !== 'enviado') {\n  throw new Error('PocketBase no confirmo el estado enviado del lead');\n}\nif (followup.lead_id !== request.lead_id || !followup.id || followup.resultado !== 'enviado') {\n  throw new Error('PocketBase no confirmo el seguimiento del envio');\n}\nif (waha.enviado_por_waha !== true || typeof waha.waha_message_id !== 'string' || !waha.waha_message_id.trim()) {\n  throw new Error('WAHA no confirmo el ID del mensaje');\n}\nreturn [{ json: { ok: true, confirmed: true, lead_id: request.lead_id,\n  waha_message_id: waha.waha_message_id, seguimiento_id: followup.id } }];"
      },
