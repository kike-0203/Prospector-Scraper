    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\nconst normal = $('CODE_NormalizarEnvio').first().json;\nif (lead.id !== normal.lead_id) throw new Error('El lead consultado no coincide con el solicitado');\nif (lead.estado === 'envio_no_confirmado') throw new Error('Este lead tiene un intento sin confirmar; revisa WAHA y n8n antes de reenviar');\nif (lead.estado === 'enviado_manual' || lead.estado_mensaje === 'enviado') throw new Error('Este lead ya figura enviado; no se repetira el mensaje');\nif (lead.estado_mensaje !== 'generado' || lead.estado_whatsapp !== 'verificado' || lead.whatsapp_verificado !== true) throw new Error('El lead no esta listo para envio manual');\nreturn [{ json: lead }];"
      },
